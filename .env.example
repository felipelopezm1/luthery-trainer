# Provision via Vercel Marketplace: Upstash for Redis
# https://vercel.com/integrations/upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional later: MuseScore.com official API for the user's own scores.
# Desktop MuseScore + mcp-musescore cannot run on Vercel; export MusicXML into /scores.
# MUSESCORE_CLIENT_ID=
# MUSESCORE_CLIENT_SECRET=
